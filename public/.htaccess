   ErrorDocument 404 /404.html

   # Paksa HTTPS dan satu versi domain (tanpa www)
   RewriteEngine On
   RewriteCond %{HTTPS} off [OR]
   RewriteCond %{HTTP_HOST} ^www\.jasalistrikbandung\.com$ [NC]
   RewriteRule ^ https://jasalistrikbandung.com%{REQUEST_URI} [L,R=301]

   <IfModule mod_headers.c>
     <FilesMatch "^_astro/">
       Header set Cache-Control "public, max-age=31536000, immutable"
     </FilesMatch>
   </IfModule>