---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  order: number;
  url: string;
}
const { title, description, image, url } = Astro.props;

const isExternal = url.startsWith('http');
---

<a
  href={url}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="group block overflow-hidden bg-white rounded shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <article>
    <Image
      src={image}
      alt={title}
      loading="lazy"
      class="aspect-[3/2] w-full object-cover"
    />
    <div class="p-6">
      <h3 class="mb-2 text-xl font-medium group-hover:underline">{title}</h3>
      <p class="leading-normal text-neutral-700 text-2xl">{description}</p>
    </div>
  </article>
</a>