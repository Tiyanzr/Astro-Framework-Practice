---
import { Image } from "astro:assets";
import bannerImg from "@/assets/images/banner/banner-home.jpg";
import {contact} from "@/constant/site";
---

<section class="relative w-full overflow-hidden">
  <Image
    src={bannerImg}
    alt="Banner Jasa Listrik Bandung"
    widths={[480, 768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    class="h-[320px] w-full object-cover sm:h-[400px] md:h-[500px] lg:h-[600px]"
  />

  <div class="absolute inset-0 bg-black/50"></div>

  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="max-w-2xl text-3xl font-bold text-white sm:text-4xl md:text-5xl lg:text-6xl">
        Jasa Instalasi Listrik Profesional di Bandung
      </h1>
      <p class="mt-4 max-w-xl text-base text-white/80 md:text-lg">
        Instalasi, perbaikan, dan perawatan listrik untuk rumah dan bisnis Anda.
      </p>
      <a
        href={contact.whatsapp}
        class="mt-6 inline-block rounded-sm bg-secondary px-6 py-3 text-base font-bold text-white transition-colors hover:opacity-90 md:text-lg"
      >
        Hubungi Kami
      </a>
    </div>
  </div>
</section>