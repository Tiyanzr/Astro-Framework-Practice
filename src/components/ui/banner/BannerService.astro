---
import { Image } from "astro:assets";
import bannerImg from "@/assets/images/banner/banner-service.jpg";
import BreadCrumb from "@/components/seo/BreadCrumb.astro";
---

<section class="relative w-full overflow-hidden">
  <Image
    src={bannerImg}
    alt="Banner About"
    widths={[480, 768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    class="h-[320px] w-full object-cover sm:h-[400px] md:h-[500px] lg:h-[600px]"
  />

  <div class="absolute inset-0 bg-black/50"></div>

  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <BreadCrumb variant="light" />
      </div>
      <h1 class="max-w-6xl text-white sm:text-4xl md:text-5xl lg:text-7xl">
        <div>Layanan</div>
        <div class="lg:text-5xl">Jasa Listrik Bandung</div> 
      </h1>
    </div>
  </div>
</section>