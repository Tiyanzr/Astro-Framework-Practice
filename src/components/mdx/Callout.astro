---
interface Props {
  type?: "info" | "warning";
  title?: string;
}
const { type = "info", title } = Astro.props;

const styles = {
  info: "border-secondary bg-gray-50",
  warning: "border-yellow-500 bg-yellow-50",
};
---

<aside class:list={["not-prose my-8 border-l-4 p-5", styles[type]]}>
  {title && <p class="mb-2 font-bold text-gray-900">{title}</p>}
  <div class="space-y-2 text-gray-700"><slot /></div>
</aside>