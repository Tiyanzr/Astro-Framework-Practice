---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.question,
    acceptedAnswer: { "@type": "Answer", text: i.answer },
  })),
};
---

<div class="not-prose my-8 divide-y divide-gray-200 border border-gray-200">
  {
    items.map((item) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-gray-900">
          {item.question}
          <span class="ml-4 text-secondary transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 leading-relaxed text-gray-700">{item.answer}</p>
      </details>
    ))
  }
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />