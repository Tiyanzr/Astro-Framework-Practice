---
import JsonLD from "./JsonLD.astro";

interface Props {
	homeLabel?: string;
	labels?: Record<string, string>;
	currentLabel?: string;
	variant?: "light" | "dark"; // light = teks putih (untuk di atas gambar gelap)
}

const {
	homeLabel = "Beranda",
	labels = {},
	currentLabel,
	variant = "dark",
} = Astro.props;

const isLight = variant === "light";

const defaultLabels: Record<string, string> = {
	layanan: "Layanan",
	tentang: "Tentang Kami",
	kontak: "Kontak",
	blog: "Blog",
};

const humanize = (s: string) =>
	decodeURIComponent(s)
		.replace(/[-_]+/g, " ")
		.replace(/\b\w/g, (c) => c.toUpperCase());

const segments = Astro.url.pathname.split("/").filter(Boolean);

const items = [
	{ name: homeLabel, href: "/" },
	...segments.map((seg, i) => {
		const isLast = i === segments.length - 1;
		return {
			name:
				isLast && currentLabel
					? currentLabel
					: (labels[seg] ?? defaultLabels[seg] ?? humanize(seg)),
			href: "/" + segments.slice(0, i + 1).join("/"),
		};
	}),
];

const schema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: items.map((item, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: item.name,
		item: new URL(item.href, Astro.site ?? Astro.url).href,
	})),
};
---

{
	segments.length > 0 && (
		<>
			<nav aria-label="Breadcrumb">
				<ol
					class:list={[
						"flex flex-wrap items-center gap-2 text-sm",
						isLight ? "text-white/80" : "text-gray-600",
					]}
				>
					{items.map((item, i) => (
						<li class="flex items-center gap-2">
							{i < items.length - 1 ? (
								<>
									<a href={item.href} class="hover:underline">
										{item.name}
									</a>
									<span aria-hidden="true">/</span>
								</>
							) : (
								<span
									aria-current="page"
									class:list={[
										"font-semibold",
										isLight ? "text-white" : "text-gray-900",
									]}
								>
									{item.name}
								</span>
							)}
						</li>
					))}
				</ol>
			</nav>

			<JsonLD data={schema} />
		</>
	)
}