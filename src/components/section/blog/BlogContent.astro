---
import { Image } from "astro:assets";

interface Props {
  title: string;
  author?: string;
  category?: string;
  updatedDate?: Date;
  publishDate?: Date;
  tags?: string[];
  image?:  ImageMetadata;
}

const { title, author, category, updatedDate,publishDate, tags = [], image } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<article class="bg-white p-5 sm:p-6 lg:p-8">
  <header class="mb-8 border-b border-gray-200 pb-6">
    {
      category && (
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-secondary">
          {category}
        </p>
      )
    }

    <h1 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">
      {title}
    </h1>

    <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
      {author && <span>Oleh {author}</span>}
      {
        updatedDate && (
          <span>
            Diperbarui{" "}
            <time datetime={updatedDate.toISOString()}>
              {formatDate(updatedDate)}
            </time>
          </span>
        )
      }
    </div>
  </header>

  {
    image && (
      <Image
        src={image}
        alt={title}
        class="mb-8 aspect-video w-full rounded-sm object-cover"
        loading="eager"
      />
    )
  }

  <div
  class="prose prose-lg md:prose-xl 2xl:prose-2xl !max-w-none
         prose-headings:font-bold prose-headings:text-gray-900
         prose-h2:mt-12 prose-h2:border-l-4 prose-h2:border-secondary prose-h2:pl-4
         prose-a:text-secondary
         prose-strong:text-gray-900
         prose-th:bg-gray-100 prose-th:text-left
         prose-table:block prose-table:overflow-x-auto"
>
  <slot />
</div>

  {
    tags.length > 0 && (
      <footer class="mt-10 flex flex-wrap gap-2 border-t border-gray-200 pt-6">
        {tags.map((tag) => (
          <span class="rounded-sm bg-gray-100 px-3 py-1 text-sm text-gray-600">
            {tag}
          </span>
        ))}
      </footer>
    )
  }
</article>