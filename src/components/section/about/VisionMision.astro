---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const entry = await getEntry("vision", "vision");
if (!entry) throw new Error("Konten 'vision' tidak ditemukan");

const { vision, mission, coreValuesIntro, coreValues, closing } = entry.data;

interface Props {
  src: ImageMetadata;
  alt: string;
  height?: string;
}
const { src, alt, height = "600px" } = Astro.props;
---

<section class="bg-gray-100 py-12 font-sans text-gray-800">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-12">
    <div
      class="grid gap-10 lg:grid-cols-[4fr_7fr] lg:gap-32 xl:gap-40 lg:items-start"
    >
      <div class="space-y-8">
        <div>
          <h2 class="mb-3 text-5xl text-gray-900">Visi</h2>
          <p class="text-xl leading-relaxed text-gray-700">{vision}</p>
        </div>

        <div>
          <h2 class="mb-3 text-5xl font-light text-gray-900">Misi</h2>
          <p class="text-xl leading-relaxed text-gray-700">{mission}</p>
        </div>
      </div>

      <div class="aspect-video w-full overflow-hidden bg-black">
        <Image
          src={src}
          alt={alt}
          loading="lazy"
          class="w-full border border-gray-300 object-cover"
          style={`height:${height};`}
        />
      </div>
    </div>

    <div class="mt-16">
      <h2 class="mb-6 text-5xl font-light text-gray-900">Nilai-Nilai Kami</h2>

      <p class="mb-6 text-xl text-gray-700">{coreValuesIntro}</p>

      <ul class="space-y-6">
        {
          coreValues.map((item) => (
            <li class="text-xl leading-relaxed text-gray-700">
              <strong class="font-bold text-gray-900">{item.title}:</strong>{" "}
              {item.text}
            </li>
          ))
        }
      </ul>

      <p class="mt-14 text-xl italic leading-relaxed text-gray-600">
        {closing}
      </p>
    </div>
  </div>
</section>
