---
import svg1 from "@/assets/icons/whatdifferent/svg1.jpg";
import svg2 from "@/assets/icons/whatdifferent/svg2.jpg";
import svg3 from "@/assets/icons/whatdifferent/svg3.jpg";
import { Image } from "astro:assets";

const features = [
  {
    icon: svg1,
    title: "Garansi & Harga Transparan",
    description:
      "Rincian biaya diberikan secara tertulis sebelum pekerjaan dimulai, tanpa tambahan biaya tersembunyi. Setiap pekerjaan dilengkapi garansi tertulis dan dokumentasi foto sebelum dan sesudah, menggunakan material ber-SNI.",
    linkText: "Lihat Selengkapnya",
    linkUrl: "#",
  },
  {
    icon: svg2,
    title: "Respons Cepat & Layanan Darurat",
    description:
      "Listrik mati atau korsleting tidak bisa menunggu. Pesan WhatsApp Anda kami balas dalam hitungan menit, dan teknisi siap meluncur ke lokasi dengan tarif darurat yang jelas sejak awal. Tersedia 24 jam untuk wilayah layanan kami.",
    linkText: "Hubungi via WhatsApp", // Kosongkan jika tidak ada link
    linkUrl: "https://wa.me/628XXXXXXXXXX",
  },
  {
    icon: svg3,
    title: "Teknisi Bersertifikat & Perawatan Berkala",
    description:
      "Ditangani teknisi yang kompeten di bidang kelistrikan, dengan layanan inspeksi dan perawatan berkala untuk mendeteksi masalah pada kabel, MCB, dan grounding sebelum berubah menjadi gangguan atau bahaya.",
    linkText: "Jadwalkan Inspeksi",
    linkUrl: "#",
  },
];
---

<section class="bg-gray-100 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-screen-2xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-gray-900 mb-12">
      Mengapa Memilih Jasa Kelistrikan Kami
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      {
        features.map((item) => (
          <div class="flex flex-col items-center px-4">
            <div class="w-60 h-60 mb-6 flex items-center justify-center">
              <Image
                src={item.icon}
                alt={item.title}
                class="w-full h-full object-contain"
              />
            </div>

            <h3 class="text-3xl font-bold text-gray-900 mb-4">{item.title}</h3>

            <p class="text-gray-600 text-lg sm:text-xl leading-relaxed mb-6 flex-grow">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
