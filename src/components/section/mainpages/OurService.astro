---
import CardOurService from "../../ui/card/CardOurService.astro";
import InstalasiListrik from "@/assets/images/upload/instalasi-listrik.jpg";
import PanelDanDistribusi from "@/assets/images/upload/panel-dan-distribusi.jpg";
import ListrikIndustri from "@/assets/images/upload/listrik-industri.jpg";
import TroubleShootingListrik from "@/assets/images/upload/troubleshooting-listrik.jpg";
import PenangkalDanGrounding from "@/assets/images/upload/penangkal-dan-grounding.jpg";
import InstalasiGenset from "@/assets/images/upload/instalasi-genset.jpg";
import Plts from "@/assets/images/upload/plts.jpg";
import Cctv from "@/assets/images/upload/cctv.jpg";
import Penerangan from "@/assets/images/upload/penerangan.jpg";
import InstalasiPompa from "@/assets/images/upload/instalasi-pompa.jpg";
import SmartHome from "@/assets/images/upload/smart-home.jpg";
import InstalasiKomputerDanJaringan from "@/assets/images/upload/instalasi-komputer-dan-jaringan.jpg";

const teknologi = [
    {
        deskripsi:
            "Instalasi listrik untuk rumah tinggal, ruko, kantor, gedung, gudang, dan pabrik, penambahan titik dan daya listrik, rewiring / penggantian kabel listrik, instalasi stop kontak dan saklar, serta instalasi lampu/penerangan.",
        judul: "Instalasi Listrik",
        gambar: InstalasiListrik,
    },
    {
        judul: "Panel & Distribusi Listrik",
        deskripsi:
            "Pembuatan dan instalasi panel listrik, panel MDP, panel SDP, panel DB, panel kontrol, panel ATS/AMF, panel kapasitor bank, modifikasi / upgrade panel, perbaikan panel listrik, serta troubleshooting panel.",
        gambar: PanelDanDistribusi,
    },
    {
        judul: "Instalasi Electrical Machinery",
        deskripsi:
            "Wiring mesin, instalasi motor listrik, instalasi control panel, instalasi sensor, instalasi sistem kontrol, cable tray & cable ladder, instalasi electrical equipment, serta maintenance electrical pabrik.",
        gambar: ListrikIndustri,
    },
    {
        judul: "Perbaikan & Troubleshooting Listrik",
        deskripsi:
            "Perbaikan korsleting, MCB sering turun/trip, listrik padam sebagian, kabel panas atau terbakar, stop kontak dan saklar rusak, pencarian gangguan (fault finding), serta layanan darurat kelistrikan.",
        gambar: TroubleShootingListrik,
    },
    {
        judul: "Instalasi Penangkal Petir & Grounding",
        deskripsi:
            "Instalasi penangkal petir konvensional dan elektrostatis, sistem grounding/pentanahan, pengukuran tahanan tanah, perbaikan sistem proteksi petir, serta surge protection.",
        gambar: PenangkalDanGrounding,
    },
    {
        judul: "Instalasi Genset & Sumber Daya Cadangan",
        deskripsi:
            "Instalasi genset, panel ATS/AMF, instalasi UPS, sistem backup power, serta maintenance genset berkala.",
        gambar: InstalasiGenset,
    },
    {
        judul: "Instalasi Panel Surya (PLTS)",
        deskripsi:
            "Instalasi PLTS atap on-grid, off-grid, dan hybrid, pemasangan inverter dan baterai, serta maintenance sistem tenaga surya.",
        gambar: Plts,
    },
    {
        judul: "Instalasi CCTV, Jaringan & Sistem Keamanan",
        deskripsi:
            "Pemasangan CCTV, kabel LAN dan jaringan, access control, alarm, intercom, serta fire alarm.",
        gambar: Cctv,
    },
    {
        judul: "Instalasi Penerangan Khusus",
        deskripsi:
            "Lampu jalan (PJU), lampu taman dan landscape, lampu sorot, lampu industri (high bay), serta lampu emergency dan exit sign.",
        gambar: Penerangan,
    },
    {
        judul: "Instalasi Pompa",
        deskripsi: "Instalasi kelistrikan pompa air, panel kontrol pompa",
        gambar: InstalasiPompa,
    },
    {
        judul: "Instalasi Smart Home & Otomasi",
        deskripsi:
            "Sistem rumah pintar, kontrol lampu dan tirai otomatis, otomasi gedung (BMS), serta integrasi sensor dan IoT.",
        gambar: SmartHome,
    },
    {
        judul: "Instalasi Komputer & Jaringan",
        deskripsi:
            "Instalasi dan setup komputer/PC dan laptop, instalasi kabel LAN dan fiber optic, pemasangan access point dan WiFi, konfigurasi router dan switch, pembuatan server dan jaringan lokal (LAN), rak jaringan (network rack) dan patch panel, serta troubleshooting dan maintenance jaringan.",
        gambar: InstalasiKomputerDanJaringan,
    },
];
---

<section class="bg-gray-100 px-4 py-16">
    <h2 class="mb-12 text-center text-4xl font-bold">
        <div class="w-12 h-1 bg-green-500 mx-auto mb-3"></div>
        Jasa apa yang kami tawarkan
    </h2>
    <div class="mx-auto grid max-w-8xl gap-10 md:grid-cols-2 xl:grid-cols-3">
        {teknologi.map((item) => <CardOurService {...item} />)}
    </div>
</section>
