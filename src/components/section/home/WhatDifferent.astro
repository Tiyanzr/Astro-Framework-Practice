---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const features = (await getCollection("whatDifferent"));
---

<section class="py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-screen-2xl mx-auto">  
    <div class="w-12 h-1 bg-green-500 mx-auto mb-3"></div>
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-gray-900 mb-12">
      Mengapa Memilih Jasa Kelistrikan Kami
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      {
        features.map((feature) => (
          <div class="flex flex-col items-center px-4">
            <div class="w-60 h-60 mb-6 flex items-center justify-center">
              <Image
                src={feature.data.icon}
                alt={feature.data.title}
                class="w-full h-full object-contain"
              />
            </div>

            <h3 class="text-3xl font-bold text-gray-900 mb-4">{feature.data.title}</h3>

            <p class="text-gray-600 text-lg sm:text-xl leading-relaxed mb-6 flex-grow">
              {feature.data.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
