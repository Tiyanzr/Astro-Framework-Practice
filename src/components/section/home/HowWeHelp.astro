---
interface Props {
    title?: string;
    buttonText?: string;
    buttonUrl?: string;
    videoEmbedUrl?: string;
}

import { getEntry, render } from "astro:content";

const entry = await getEntry("howWeHelp", "how-we-help");
if (!entry) throw new Error("Konten 'how-we-help' tidak ditemukan");

const { title, buttonText, buttonUrl, videoEmbedUrl } = entry.data;
const { Content } = await render(entry);
---

<section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-screen-2xl mx-auto">
        <div class="text-center mb-12">
            <div class="w-12 h-1 bg-green-500 mx-auto mb-3"></div>
            <h2 class="text-3xl font-bold text-gray-900">{title}</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <div class="space-y-6 text-gray-600 leading-relaxed text-lg md:text-xl lg:text-2xl">
                <Content />

                <div class="pt-4">
                    <a
                        href={buttonUrl}
                        class="inline-block bg-secondary text-white font-medium px-6 py-3 rounded-sm hover:bg-gray-800 transition-colors"
                    >
                        {buttonText}
                    </a>
                </div>
            </div>

            <div class="relative w-full aspect-video rounded-sm overflow-hidden shadow-md">
                <iframe
                    class="absolute top-0 left-0 w-full h-full"
                    src={videoEmbedUrl}
                    title="Layanan Jasa Kelistrikan"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                >
                </iframe>
            </div>
        </div> 
    </div>
</section>