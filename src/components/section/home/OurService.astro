---
import CardOurService from "../../ui/card/CardOurService.astro";
import { getCollection } from "astro:content";


const services = (await getCollection("ourService")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="px-4 py-16">
    <h2 class="mb-12 text-center text-4xl font-bold">
        <div class="w-12 h-1 bg-green-500 mx-auto mb-3"></div>
        Jasa apa yang kami tawarkan
    </h2>
    <div class="mx-auto grid max-w-8xl gap-10 md:grid-cols-2 xl:grid-cols-3">
        {services.map((service) => <CardOurService {...service.data} />)}
    </div>
</section>
