---
import { mainLinks } from "@/constant/navigation";
import { Image } from "astro:assets";
import logo from "@/assets/icons/logo.png";
import LanguageSwitcher from "../ui/shared/language-switcher";
import {contact} from "@/constant/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-header-bg">
  <nav
    class="flex h-16 w-full items-center justify-between px-4 sm:px-6 md:h-20 lg:h-24 lg:px-8"
  >
    <a href="/" class="flex shrink-0 items-center ml-24">
      <Image
        src={logo}
        alt="Logo MyWebsite"
        class="h-10 w-auto md:h-12 lg:h-14"
        loading="eager"
      />
    </a>

    <ul class="hidden items-center gap-2 lg:flex xl:gap-8">
      {
        mainLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-sm px-4 py-3 text-base font-bold leading-none transition-colors xl:px-5 xl:text-xl",
                isActive(link.href)
                  ? "bg-secondary text-white"
                  : "text-white/70 hover:bg-hover hover:text-white",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 sm:gap-4">
      <a
        href={contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-sm border border-white px-5 py-3 text-base font-bold leading-none text-white transition-colors hover:bg-hover lg:block xl:text-lg"
      >
        Hubungi Kami
      </a>

      <LanguageSwitcher client:load />

      <button
        id="menu-toggle"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="rounded-lg p-2 text-white transition-colors hover:bg-hover lg:hidden"
      >
        <svg
          id="icon-open"
          class="size-7"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="hidden size-7"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="absolute left-0 right-0 top-full hidden border-t border-white/10 bg-primary shadow-lg lg:hidden"
  >
    <ul class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6">
      {
        mainLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-lg px-4 py-3 text-lg font-bold transition-colors",
                isActive(link.href)
                  ? "bg-secondary text-white"
                  : "text-white/70 hover:bg-hover hover:text-white",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={contact.whatsapp}
          class="block rounded-lg border border-white px-4 py-3 text-center text-lg font-bold text-white transition-colors hover:bg-hover"
        >
          Hubungi Kami
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
  };

  toggle?.addEventListener("click", () => {
    setOpen(menu?.classList.contains("hidden") ?? false);
  });

  // Tutup saat salah satu link diklik
  menu
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));

  // Tutup otomatis saat layar dilebarkan ke ukuran laptop
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
