---
interface Item {
  label: string;
  href: string;
}

interface Props {
  heading?: string;
  title?: string;
  items?: Item[];
}

const { heading, title, items } = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, "");
---

<aside class="w-full self-start border border-gray-200 bg-white">
  <div class="m-3 border border-gray-200 bg-gray-50 px-5 py-4">
    <h2 class="text-lg font-bold uppercase tracking-wide text-secondary">
      {heading}
    </h2>
  </div>

  <div class="px-5 pb-6 pt-4">
    <h3 class="text-xl font-extrabold uppercase text-slate-900">{title}</h3>
    <div class="mt-2 h-[3px] w-20 bg-secondary"></div>

    <ul class="mt-6 space-y-3.5">
      {
        items?.map((item) => {
          const active = current === item.href.replace(/\/$/, "");
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "group flex items-center gap-2 text-[15px] font-medium transition-colors",
                  active
                    ? "text-orange-500"
                    : "text-gray-700 hover:text-orange-500",
                ]}
              >
                <span
                  aria-hidden="true"
                  class:list={[
                    "h-0 w-0 shrink-0 border-y-[4px] border-l-[5px] border-y-transparent transition-colors",
                    active
                      ? "border-l-orange-500"
                      : "border-l-gray-500 group-hover:border-l-orange-500",
                  ]}
                ></span>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</aside>