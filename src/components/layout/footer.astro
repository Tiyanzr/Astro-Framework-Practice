---
import logo from "@/assets/icons/logo.png";
import { Image } from "astro:assets";

const namaPerusahaan = "Jasa Listrik Bandung";
const alamat =
    "Jl. Puyuh Dalam No.229 RT.03 RW.11 Kel.Sadang Serang Kec.Coblong Kota Bandung, Jawa Barat";
const telepon = "0822-1981-4144";
const teleponHref = "tel:+6282219814144";
const tahun = new Date().getFullYear();
---

<footer
    class="bg-footer-bg z-50 text-base leading-normal text-footer-text font-[Raleway,system-ui,sans-serif]"
>
    <div
        class="flex w-full flex-col items-start justify-between gap-8 px-4 py-10 lg:flex-row lg:items-center lg:gap-12 lg:px-6"
    >
        <a
            href="/"
            aria-label={namaPerusahaan}
            class="inline-flex shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
            <Image
                src={logo}
                alt={namaPerusahaan}
                class="block h-12 w-auto lg:h-14"
            />
        </a>

        <div
            class="flex w-full flex-row items-center gap-8 lg:flex-1"
        >
            <p class="m-0 lg:whitespace-nowrap">
                © Copyright {tahun} {namaPerusahaan}
            </p>

            <address
                class="ml-auto flex flex-col items-end gap-1 text-right font-semibold not-italic lg:max-w-sm"
            >
                <span>{alamat}</span>
                <a
                    href={teleponHref}
                    class="no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    Telp. {telepon}
                </a>
            </address>
        </div>
    </div>
</footer>
