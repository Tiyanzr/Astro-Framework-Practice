---
import "../styles/global.css";
import Navbar from "@/components/layout/navbar.astro";
import Footer from "@/components/layout/footer.astro";
import Sidebar from "@/components/layout/sidebar.astro";
import {serviceLinks} from "@/constant/navigation";
import icon from "@/assets/icons/logo.png";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={icon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>Jasa Listrik Bandung</title>
	</head>
	<body class="flex min-h-screen flex-col bg-bg">
		<Navbar />

		<slot name="banner" />

		<div class="grid w-full flex-1 gap-8 lg:grid-cols-[280px_1fr]">
			<Sidebar {...serviceLinks}  />
			<main class="min-w-0 px-4 py-8 lg:pl-0 lg:pr-8">
				<slot />
			</main>
		</div>

		<Footer />
	</body>
</html>
