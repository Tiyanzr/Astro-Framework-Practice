---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BannerAbout from "@/components/ui/banner/BannerAbout.astro";
import VisionMision from "@/components/section/about/VisionMision.astro";
import company from "@/assets/images/about/company.png";
import { localBusinessSchema } from "@/lib/seo/schema";
import JsonLd from "@/components/seo/JsonLD.astro";
---

<BaseLayout title="Tentang Perusahaan Jasa Listrik Bandung" description="Jasa Listrik Bandung">
    <JsonLd slot="head" data={localBusinessSchema(Astro.site!)} />
    <BannerAbout />
    <VisionMision src={company} alt="Deskripsi gambar" height="600px"  />
</BaseLayout>